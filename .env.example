# Required
DATABASE_URL=postgresql://user:pass@host:port/dbname
GBRAIN_OAUTH_PASSWORD=your-master-password-here

# Optional (defaults shown)
PORT=8787
HOST=127.0.0.1
GBRAIN_BIN=/home/ec2-user/.bun/bin/gbrain
GBRAIN_POOL_SIZE=3
GBRAIN_HOOK_RUNNING=1
WRAPPER_BASE_URL=https://your-domain.example.com

# Advanced (rarely needed)
# GBRAIN_RATE_LIMIT_RPM=120
# LOG_GBRAIN_STDERR=1
# BUN_BIN=/path/to/bun
